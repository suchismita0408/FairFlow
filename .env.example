FAIRFLOW_MODE=demo
AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
APP_BASE_URL=http://127.0.0.1:8000
FAIRFLOW_ADMIN_TOKEN=replace-with-a-long-random-secret
DATABASE_PATH=fairflow.db

PAYPAL_VAULT_ENABLED=false

GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.8-flash
GEMINI_ATTEMPT_TIMEOUT_SECONDS=25
GEMINI_TOTAL_TIMEOUT_SECONDS=75

# Authenticated local platform: generate actual local values with python -m scripts.setup_local
AUTH_ENABLED=true
EMAIL_MODE=local
APP_ENV=development
# DATABASE_URL and TOKEN_ENCRYPTION_KEY are generated by setup_local; do not commit them.
RUN_EMBEDDED_WORKER=false
INVITATION_EXPIRY_DAYS=7
ENABLE_LEGACY_ACCOUNTS=false
ENABLE_LEGACY_DEMO_LOGIN=false

# Enable only currencies confirmed for your Sandbox merchant. Demo supports the catalog.
PAYPAL_ENABLED_CURRENCIES=USD

# Optional real verification mail: set EMAIL_MODE=smtp after configuring these.
# Use provider-issued credentials, never commit your actual .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Registered, verified accounts allowed to review OTHER participants' cases.
# These people must sign in; no default admin or reviewer is created.
FAIRFLOW_SUPPORT_EMAILS=

# Separate Sandbox Multiparty credentials live in .env.paypal-platform.
# Optional override for that private file; never point it at live credentials.
# PAYPAL_PLATFORM_CONFIG=

# Select the upfront-funded Platform flow; missing credentials must not downgrade it.
PAYPAL_PAYMENT_FLOW=platform
